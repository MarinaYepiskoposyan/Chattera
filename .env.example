# Chattera local dev environment
#
# Copy this file to `.env` (which is gitignored) and fill in real values for
# local development. Nothing in this file is a real secret; every value is a
# placeholder. Do not reuse these values anywhere but a local machine.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Postgres — application database (chattera)
# ---------------------------------------------------------------------------
# Bootstrap superuser for the Postgres container. Also owns the `chattera`
# application database (created automatically by the official postgres
# image from these three vars). Chattera services / Flyway migrations
# connect using these credentials against POSTGRES_DB.
POSTGRES_USER=chattera
POSTGRES_PASSWORD=changeme_chattera_dev_password
POSTGRES_DB=chattera
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Postgres — Keycloak's separate database + least-privilege role
# ---------------------------------------------------------------------------
# Created by infra/postgres/init/01-init-keycloak-db.sh the first time the
# postgres container initializes its data volume. This role owns ONLY the
# `keycloak` database — it has no access to the `chattera` application
# database. Keycloak connects to Postgres using these credentials.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme_keycloak_dev_password

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
# Port the Keycloak HTTP interface (login pages, admin console, OIDC
# endpoints) is published on.
KEYCLOAK_PORT=8080
# Bootstrap admin account for the Keycloak Admin Console (first run only —
# used to log in at http://localhost:8080/admin). Mapped internally to
# Keycloak's KC_BOOTSTRAP_ADMIN_USERNAME / KC_BOOTSTRAP_ADMIN_PASSWORD.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_admin_dev_password

# ---------------------------------------------------------------------------
# Keycloak — DEV/TEST ONLY smoke-testing client + user
# ---------------------------------------------------------------------------
# `chattera-test-client` / `testuser` are baked directly into
# infra/keycloak/realm-export/chattera-realm.json (Keycloak's realm import
# does not do env-var substitution here), so these values are NOT read by
# docker-compose — they're captured here purely for discoverability, so
# nobody has to go spelunking in the realm JSON to find them.
#
# `chattera-test-client` is a confidential client with
# directAccessGrantsEnabled=true (Resource Owner Password Credentials grant),
# used ONLY for headless automated smoke testing against services like
# profile-service, since there's no frontend yet to drive the real
# browser-based PKCE flow that chattera-web/chattera-mobile use in
# production. NEVER enable directAccessGrantsEnabled on a client in
# staging/production — see infra/README.md.
KEYCLOAK_TEST_CLIENT_ID=chattera-test-client
KEYCLOAK_TEST_CLIENT_SECRET=29783f3965931971396b129def2e82eac45bc259527aaf89
KEYCLOAK_TEST_USERNAME=testuser
KEYCLOAK_TEST_USER_PASSWORD=186ba229b456666f3a76d3de

# ---------------------------------------------------------------------------
# Redis — cache / presence keys
# ---------------------------------------------------------------------------
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MinIO — S3-compatible object storage (file service backing store)
# ---------------------------------------------------------------------------
# Root credentials for the MinIO server (used to create scoped
# access keys/buckets later; file-service does not use these root
# credentials directly once bucket-scoped keys exist).
MINIO_ROOT_USER=chattera-minio-admin
MINIO_ROOT_PASSWORD=changeme_minio_dev_password
# S3 API port and web console port.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
